{
	"private": true,
	"type": "module",
	"name": "crm",
	"packageManager": "yarn@1.22.22",
	"description": "PARAMA CRM brings travel sales, itineraries, communication, and follow-ups into one workspace.",
	"author": "PARAMA CRM",
	"license": "GPL-3.0",
	"scripts": {
		"postinstall": "cd frontend && yarn install --check-files",
		"dev": "cd frontend && yarn dev",
		"dev:stack": "bash scripts/start-dev.sh",
		"build": "cd frontend && yarn build",
		"upgrade-frappeui": "cd frontend && yarn add frappe-ui@latest && cd ..",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@types/node": "^22.0.0"
	}
}
